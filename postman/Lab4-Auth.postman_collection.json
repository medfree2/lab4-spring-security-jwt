{
  "info": {
    "name": "Lab 4 — Authentification JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminUsername",
      "value": "lab-admin"
    },
    {
      "key": "managerUsername",
      "value": "lab-manager"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "managerPassword",
      "value": ""
    },
    {
      "key": "demoPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Lecture anonyme",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId', Date.now().toString(36));"
            ]
          }
        }
      ]
    },
    {
      "name": "Inscription",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"client-{{runId}}\", \"password\": \"{{demoPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Vérifier le résultat\", () => { pm.expect(pm.response.json().role).to.eql('USER'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Inscription du second client",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"autre-{{runId}}\", \"password\": \"{{demoPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Connexion utilisateur",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"client-{{runId}}\", \"password\": \"{{demoPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Vérifier le résultat\", () => { pm.collectionVariables.set('userToken', pm.response.json().token); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Connexion du second client",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"autre-{{runId}}\", \"password\": \"{{demoPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Vérifier le résultat\", () => { pm.collectionVariables.set('otherToken', pm.response.json().token); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Connexion administrateur",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{adminUsername}}\", \"password\": \"{{adminPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Vérifier le résultat\", () => { pm.collectionVariables.set('adminToken', pm.response.json().token); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Connexion manager",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{managerUsername}}\", \"password\": \"{{managerPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Vérifier le résultat\", () => { pm.collectionVariables.set('managerToken', pm.response.json().token); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Lecture du catalogue",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Écriture interdite au client",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/categories",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Test\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Créer une catégorie",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/categories",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Informatique\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Vérifier le résultat\", () => { pm.collectionVariables.set('categoryId', pm.response.json().id); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Créer un produit comme manager",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/products",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Clavier\", \"price\": 199, \"categoryId\": {{categoryId}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Vérifier le résultat\", () => { pm.collectionVariables.set('productId', pm.response.json().id); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Suppression interdite au manager",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/products/{{productId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Créer sa commande",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/orders",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"items\": [{\"productId\": {{productId}}, \"quantity\": 2}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Vérifier le résultat\", () => { pm.collectionVariables.set('orderId', pm.response.json().id); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Lister ses commandes",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Vérifier le résultat\", () => { pm.expect(pm.response.json().content.map(order => order.id)).to.include(Number(pm.collectionVariables.get('orderId'))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Masquer la commande aux autres clients",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/{{orderId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{otherToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Lire la commande comme manager",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/orders/{{orderId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Supprimer la commande comme admin",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/orders/{{orderId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Refuser un renouvellement prématuré",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/refresh",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
